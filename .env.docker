# Environment stack DEVELOPMENT (dibaca container sebagai /.env).
# File ini di-commit; isinya kredensial lokal yang aman, BUKAN kredensial nyata.
# Jangan pernah memakai nilai di sini untuk server live.
APP_NAME=Warungku
APP_ENV=local
APP_KEY=base64:y6ZHwX0vXwzrGP/WNSEfB+O/rbZWedcdI5IEc2E2ti8=
APP_DEBUG=true
APP_URL=http://localhost:8010
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=warungku_dev
DB_USERNAME=warungku
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="warungku@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# Port aplikasi yang dipublikasikan ke host (compose.yaml).
APP_PORT=8010
# Supaya operator tidak perlu ingat dua tempat: DB_PORT dipakai compose untuk
# port MySQL di host.
DB_PUBLISH_PORT=3309
