# Environment LIVE — TEMPLATE. Salin ke `.env.live` lalu isi nilainya.
#
#   cp .env.live.example .env.live
#   php artisan key:generate --show   # tempel hasilnya ke APP_KEY
#
# `.env.live` TIDAK di-commit (lihat .gitignore). Jangan pernah memakai
# kredensial dev dari `.env.docker` di sini.
APP_NAME=Warungku
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8011
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Live: jangan pakai debug, cukup warning ke atas.
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=warungku
DB_USERNAME=warungku
# WAJIB diganti dengan password kuat sebelum dipakai.
DB_PASSWORD=ganti-dengan-password-kuat

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true di live kalau dilayani lewat HTTPS.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="warungku@localhost"
MAIL_FROM_NAME="${APP_NAME}"

APP_PORT=8011

# Set true kalau aplikasi dilayani lewat HTTPS (reverse proxy / TLS langsung).
# Biarkan false untuk akses http (mis. IP lokal atau di belakang proxy yang
# menerminasi TLS).
FORCE_HTTPS=false
