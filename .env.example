# Template environment untuk jalan NATIVE di host (tanpa Docker).
# Untuk Docker, file yang dipakai adalah `.env.docker`.
APP_NAME=Warungku
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Host menjalankan PHP, jadi MySQL harus bisa dihubungi lewat 127.0.0.1
# (port yang dipublikasi compose: 3309).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3309
DB_DATABASE=warungku_dev
DB_USERNAME=warungku
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="warungku@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# Identitas toko yang tampil di navigasi dan struk.
NAMA_TOKO="Warungku"
ALAMAT_TOKO=""
TELEPON_TOKO=""

# Kata sandi admin yang dibuat seeder (ganti setelah login pertama).
ADMIN_PASSWORD=admin12345
